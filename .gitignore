# Track only explicitly approved deployment files. Runtime data stays local.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/.env.example
!/jellyfin/
!/immich/
!/nginx/
!/navidrome/
!/portainer/

/jellyfin/*
!/jellyfin/docker-compose.yml
!/jellyfin/.env.example

/immich/*
!/immich/docker-compose.yml
!/immich/.env.example

/nginx/*
!/nginx/docker-compose.yml
!/nginx/etc/
/nginx/etc/*
!/nginx/etc/nginx/
/nginx/etc/nginx/*
!/nginx/etc/nginx/sites-available/
/nginx/etc/nginx/sites-available/*
!/nginx/etc/nginx/sites-available/jellyfin

/navidrome/*
!/navidrome/docker-compose.yml

/portainer/*
!/portainer/docker-compose.yml
