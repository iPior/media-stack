# Track only explicitly approved deployment files. Runtime data stays local.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/.env.example
!/jellyfin/
!/immich/
!/nginx/
!/navidrome/
!/portainer/
!/homepage/
!/adguard/

/jellyfin/*
!/jellyfin/docker-compose.yml
!/jellyfin/.env.example

/immich/*
!/immich/docker-compose.yml
!/immich/.env.example

/nginx/*
!/nginx/docker-compose.yml
!/nginx/etc/
/nginx/etc/*
!/nginx/etc/nginx/
/nginx/etc/nginx/*
!/nginx/etc/nginx/sites-available/
/nginx/etc/nginx/sites-available/*
!/nginx/etc/nginx/sites-available/jellyfin

/navidrome/*
!/navidrome/docker-compose.yml

/portainer/*
!/portainer/docker-compose.yml

/homepage/*
!/homepage/docker-compose.yml
!/homepage/.env.example
!/homepage/README.md
!/homepage/config/
/homepage/config/*
!/homepage/config/settings.yaml
!/homepage/config/services.yaml
!/homepage/config/widgets.yaml
!/homepage/config/bookmarks.yaml
!/homepage/config/docker.yaml
!/homepage/config/kubernetes.yaml

/adguard/*
!/adguard/docker-compose.yml
!/adguard/.env.example
!/adguard/README.md
