# Port used to open the dashboard on this server.
HOMEPAGE_PORT=2999
# Replace/add your server's LAN IP or hostname, including :2999 for direct access.
# Example: 192.168.1.50:2999,homepage.example.com
# No scheme, paths, or spaces; match the address in your browser exactly.
HOMEPAGE_ALLOWED_HOSTS=localhost:2999,127.0.0.1:2999
# Hostname or LAN IP used by all service links, without scheme or port.
# localhost is only suitable when browsing on the server itself.
HOMEPAGE_VAR_SERVER_HOST=localhost
TIMEZONE=America/Toronto
# Match the owner of homepage/config so Homepage can write its configuration/logs.
PUID=1000
PGID=1000
